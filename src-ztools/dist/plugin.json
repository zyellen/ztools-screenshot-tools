{
  "$schema": "node_modules/@ztools-center/ztools-api-types/resource/ztools.schema.json",
  "name": "ztools-screenshot-tools",
  "title": "截图工具箱",
  "description": "截图、OCR 文字识别、长截图与翻译工具",
  "author": "zyellen",
  "version": "0.5.3",
  "main": "dist/index.html",
  "preload": "preload/services.js",
  "logo": "logo.png",
  "development": {
    "main": "http://localhost:5173"
  },
  "platform": [
    "darwin",
    "win32"
  ],
  "features": [
    {
      "code": "screenshot",
      "explain": "框选截图，支持标注/OCR/翻译/滚动截图/悬浮贴图",
      "icon": "logo.png",
      "cmds": [
        "截图",
        "截屏",
        "screenshot"
      ]
    },
    {
      "code": "long-shot",
      "explain": "框选区域，手动或自动滚动拼接长图",
      "icon": "logo.png",
      "cmds": [
        "长截图",
        "滚动截图",
        "long-shot"
      ]
    },
    {
      "code": "image-process",
      "explain": "对粘贴的图片进行 OCR / 翻译 / 保存",
      "icon": "logo.png",
      "cmds": [
        {
          "type": "img",
          "label": "图片识别"
        }
      ]
    }
  ]
}
